# Live domain (canonical URLs, sitemap). Leave unset for https://www.theprive.network
# NEXT_PUBLIC_SITE_URL=https://www.theprive.network

# ── "Request an invitation" form (app/api/invitation/route.ts) ──
# Set at least one destination, or live submissions are refused (and logged) instead of lost.

# Option A (recommended): Google Sheet + email via Google Apps Script. See scripts/invitation-sheet.gs
INVITATION_WEBHOOK_URL=
INVITATION_WEBHOOK_SECRET=

# Option B: email each request via Resend (resend.com; theprive.network must be verified there)
RESEND_API_KEY=
INVITATION_EMAIL_TO=info@theprive.network
INVITATION_EMAIL_FROM=Privé Website <invitations@theprive.network>
